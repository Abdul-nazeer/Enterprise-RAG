# Application Settings
APP_NAME="Enterprise RAG Platform"
ENVIRONMENT=development
DEBUG=true

# Security (CHANGE THIS IN PRODUCTION!)
SECRET_KEY=your-super-secret-key-at-least-32-characters-long-change-this

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/enterprise_rag

# Redis
REDIS_URL=redis://localhost:6379/0

# Qdrant Vector Database
QDRANT_URL=http://localhost:6333
# QDRANT_API_KEY=  # Optional, for Qdrant Cloud

# LLM APIs (Free tier!)
GROQ_API_KEY=  # Get free key from https://console.groq.com
OLLAMA_URL=http://localhost:11434  # Local fallback

# LangFuse Observability (Optional)
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=

# Session Settings
SESSION_TTL_HOURS=24
MAX_UPLOAD_SIZE_MB=50
MAX_FILES_PER_SESSION=100

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_PER_HOUR=1000
